# This file is PUBLIC (it is on GitHub). Never put real values here.
#
# Copy it to a file named ".env" (that one is never uploaded) ONLY if you want
# START.bat to use the online Supabase database instead of data/db.json.
# On Netlify, put the same settings in Site configuration -> Environment variables.
#
# Supabase: Project Settings -> Data API (URL) and API Keys (secret key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-secret-key

# Passwords given to the accounts when they are first created (8+ characters each)
ADMIN_PASSWORD=choose-a-password
DEPT_PASSWORD=choose-a-password
WORKER_PASSWORD=choose-a-password
