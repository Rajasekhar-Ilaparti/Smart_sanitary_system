# Copy this file to ".env" ONLY if you want START.bat to use the online Supabase
# database instead of data/db.json. Never upload .env anywhere.
# Find these in Supabase: Project Settings -> Data API (URL) and API Keys (secret key).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-secret-key
